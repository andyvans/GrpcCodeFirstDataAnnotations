<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<PackageId>Codify.GrpcCodeFirstDataAnnotations</PackageId>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\Codify.GrpcCodeFirstDataAnnotations.xml</DocumentationFile>
		<Product>Codify.GrpcCodeFirstDataAnnotations</Product>
		<Description>Data annotation validations for gRPC Code-first models in AspNetCore</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>codify.png</PackageIcon>
	</PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Grpc.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\README.md">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
      <None Include="..\..\codify.png">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
      <None Include="..\..\LICENSE">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Codify.GrpcCodeFirstDataAnnotations.Exceptions\Codify.GrpcCodeFirstDataAnnotations.Exceptions.csproj" />
    </ItemGroup>

</Project>
