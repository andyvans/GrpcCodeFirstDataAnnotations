<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Codify.GrpcCodeFirstDataAnnotations</PackageId>
        <Version>1.0.0</Version>
        <Authors>Andy van Stokkum</Authors>
        <PackageTags>grpc;code-first;data-annotations;validation</PackageTags>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageProjectUrl>https://github.com/andyvans/GrpcCodeFirstDataAnnotations</PackageProjectUrl>
        <TargetFramework>net10.0</TargetFramework>
        <DocumentationFile>bin\Debug\Codify.Codify.GrpcCodeFirstDataAnnotations.xml</DocumentationFile>
        <Company>Codify</Company>
        <Product>Codify.GrpcCodeFirstDataAnnotations</Product>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <PackageLicenseFile>license.txt</PackageLicenseFile>
        <Description>Data annotation validations for gRPC Code-first models in AspNetCore</Description>
        <RepositoryUrl>https://github.com/andyvans/GrpcCodeFirstDataAnnotations</RepositoryUrl>
        <PackageIcon>codify.png</PackageIcon>
        <PackageIconUrl />
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DocumentationFile>bin\Release\Codify.GrpcCodeFirstDataAnnotations.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DocumentationFile>bin\Debug\Codify.GrpcCodeFirstDataAnnotations.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\codify.png">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
      <None Include="..\..\license.txt">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Codify.GrpcCodeFirstDataAnnotations.Exceptions\Codify.GrpcCodeFirstDataAnnotations.Exceptions.csproj" />
    </ItemGroup>

</Project>
