<Project>

  <PropertyGroup>
    <Authors>Andy van Stokkum</Authors>
    <Company>Codify</Company>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageProjectUrl>https://github.com/andyvans/GrpcCodeFirstDataAnnotations</PackageProjectUrl>
    <RepositoryUrl>https://github.com/andyvans/GrpcCodeFirstDataAnnotations</RepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>codify.png</PackageIcon>
    <PackageIconUrl />
    <PackageTags>grpc;code-first;data-annotations;validation</PackageTags>
  </PropertyGroup>

</Project>
